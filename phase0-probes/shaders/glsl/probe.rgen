#version 460
#extension GL_EXT_ray_tracing : require
layout(set = 0, binding = 0) uniform accelerationStructureEXT tlas;
layout(set = 0, binding = 1, rgba8) uniform writeonly image2D img;
// right is pre-scaled by aspect * tan(fov_y / 2), up by tan(fov_y / 2); forward is not normalized.
// sun.xyz = normalized direction towards the sun (read in probe.rchit).
layout(push_constant) uniform Camera { vec4 origin; vec4 forward; vec4 right; vec4 up; vec4 sun; } cam;
layout(location = 0) rayPayloadEXT vec3 color;
void main() {
  vec2 uv = (vec2(gl_LaunchIDEXT.xy) + 0.5) / vec2(gl_LaunchSizeEXT.xy) * 2.0 - 1.0;
  vec3 dir = normalize(cam.forward.xyz + uv.x * cam.right.xyz - uv.y * cam.up.xyz);
  color = vec3(0.0);
  traceRayEXT(tlas, gl_RayFlagsOpaqueEXT, 0xFF, 0, 0, 0, cam.origin.xyz, 0.001, dir, 10000.0, 0);
  imageStore(img, ivec2(gl_LaunchIDEXT.xy), vec4(color, 1.0));
}
