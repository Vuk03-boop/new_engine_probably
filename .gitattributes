# Binary data: never convert line endings (core.autocrlf is on for this machine).
# The save-format fixtures (*.journal, *.snap) and the baked sky reference (*.bin) are byte-pinned.
*.bin binary
*.journal binary
*.snap binary
*.spv binary
*.pfm binary
*.ppm binary
*.png binary
*.bmp binary
*.xls binary

# Windows batch files need CRLF line endings (run-local.cmd, docs/CLOUD.md).
*.cmd text eol=crlf
